---
// PainelMock — recriação em HTML/CSS do painel do VendeAI.
//
// Substitui o print. Vantagens de ser DOM em vez de imagem: texto nítido em
// qualquer tela e zoom, cores vindas dos tokens da marca (então acompanha
// qualquer mudança de paleta) e nenhum arquivo para baixar.
//
// Não é uma cópia literal do painel real: o estado mostrado é o de assistente
// ATIVO e WhatsApp CONECTADO, porque um print de "pausado / desconectado" numa
// página de vendas comunica o contrário do que a seção está dizendo.
//
// aria-hidden: é ilustração de produto. Quem usa leitor de tela recebe a
// descrição pelo texto da seção, não por 40 rótulos soltos de interface.

const acoes = [
  {
    olho: "Base de conhecimento",
    titulo: "Treinamentos avançados",
    desc: "Configure informações, produtos, regras e ações do agente.",
    botao: "Configurar treinamentos",
    cor: "is-azul",
    icone: "cerebro",
  },
  {
    olho: "Personalize seu agente",
    titulo: "Configurações",
    desc: "Ajuste comportamento, tom de voz e preferências gerais.",
    botao: "Configurar",
    cor: "is-ceu",
    icone: "lapis",
  },
];

const canais = [
  { nome: "WhatsApp", tag: "Conectado", tagCor: "is-on", desc: "Conectado ao número da sua empresa.", cor: "is-verde", icone: "whats" },
  { nome: "Áudio", tag: "Ativo", tagCor: "is-on", desc: "Responde e entende mensagens de voz.", cor: "is-azul", icone: "microfone" },
  { nome: "Filas", tag: "3 ativas", tagCor: "is-info", desc: "Transfere a conversa para a pessoa certa.", cor: "is-ceu", icone: "pessoas" },
  { nome: "Web Chat", tag: "Beta", tagCor: "is-beta", desc: "Widget de atendimento no seu site.", cor: "is-marinho", icone: "balao" },
];
---

<div class="ui" aria-hidden="true">

  <!-- Barra do topo -->
  <div class="ui-top">
    <div class="ui-top_esq">
      <span class="ui-logo">VendeAI</span>
      <span class="ui-pill is-on"><i></i>Online</span>
    </div>
    <span class="ui-top_dir">Agente ativo</span>
  </div>

  <!-- Faixa de saudação -->
  <div class="ui-saudacao">
    <div class="ui-avatar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="8" width="16" height="11" rx="3" />
        <path d="M12 8V5" /><circle cx="12" cy="4" r="1.2" fill="currentColor" />
        <circle cx="9.2" cy="13" r="1.1" fill="currentColor" stroke="none" />
        <circle cx="14.8" cy="13" r="1.1" fill="currentColor" stroke="none" />
      </svg>
    </div>
    <div class="ui-saudacao_txt">
      <strong>Olá! Eu sou o VendeAI, o agente da sua empresa.</strong>
      <span>Estou atendendo agora. 12 conversas em andamento.</span>
    </div>
    <div class="ui-saudacao_acoes">
      <span class="ui-btn is-fantasma">Ver conversas</span>
      <span class="ui-btn is-verde">Assistente ativo</span>
    </div>
  </div>

  <!-- Ações principais -->
  <p class="ui-label">Ações principais</p>
  <div class="ui-grid is-2">
    {acoes.map((a) => (
      <div class="ui-card">
        <div class={`ui-icone ${a.cor}`}>
          {a.icone === "cerebro" ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8V16a3 3 0 0 0 4 2.8V4Z" />
              <path d="M15 4a3 3 0 0 1 3 3 3 3 0 0 1 1 5.8V16a3 3 0 0 1-4 2.8V4Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h4L19 9a2.5 2.5 0 0 0-4-4L4 16v4Z" /><path d="M14 6l4 4" />
            </svg>
          )}
        </div>
        <p class="ui-olho">{a.olho}</p>
        <p class="ui-titulo">{a.titulo}</p>
        <p class="ui-desc">{a.desc}</p>
        <span class="ui-btn is-cheio">{a.botao}</span>
      </div>
    ))}
  </div>

  <!-- Canais -->
  <p class="ui-label">Canais de atendimento</p>
  <div class="ui-grid is-4">
    {canais.map((c) => (
      <div class="ui-card is-canal">
        <div class="ui-canal_topo">
          <div class={`ui-icone is-pequeno ${c.cor}`}>
            {c.icone === "whats" ? (
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-5.7-4.9c-.4-.7-.7-1.5-.7-2.2 0-.8.4-1.4.7-1.7.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.5l-.3.4c-.1.1-.2.3-.1.5.3.6 1 1.6 2.1 2.2.3.2.5.1.6 0l.5-.6c.2-.2.3-.2.5-.1l1.6.8c.2.1.3.2.3.3.1.2.1.6-.2 1.2Z" /></svg>
            ) : c.icone === "microfone" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0" /><path d="M12 18v3" /></svg>
            ) : c.icone === "pessoas" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3" /><path d="M3 19a6 6 0 0 1 12 0" /><path d="M16 6a3 3 0 0 1 0 6" /><path d="M18 19a6 6 0 0 0-2-4.5" /></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a7 7 0 0 1-7 7H8l-4 3v-4.6A7 7 0 0 1 8 5h5a7 7 0 0 1 7 7Z" /></svg>
            )}
          </div>
          <span class={`ui-pill ${c.tagCor}`}>{c.tag !== "Beta" && c.tagCor === "is-on" ? <i></i> : null}{c.tag}</span>
        </div>
        <p class="ui-titulo is-menor">{c.nome}</p>
        <p class="ui-desc">{c.desc}</p>
      </div>
    ))}
  </div>

</div>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BlogPostHero from "../../components/BlogPostHero.astro";
import BlogPostContent from "../../components/BlogPostContent.astro";
import BlogRelated from "../../components/BlogRelated.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;

const siteUrl = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const url = new URL(Astro.url.pathname, Astro.site).toString();
const published = article.data.date.toISOString();
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.name,
  description: article.data.summary,
  image: new URL(article.data.thumbnail, Astro.site).toString(),
  datePublicado: published,
  dateModified: published,
  author: { "@id": `${siteUrl}/#organization` },
  publisher: { "@id": `${siteUrl}/#organization` },
  mainEntityOfPage: url,
  url,
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${siteUrl}/blog/` },
    { "@type": "ListItem", position: 3, name: article.data.name, item: url },
  ],
};
---
<BaseLayout
  title={`${article.data.name} — Novus AI`}
  description={article.data.summary}
  ogType="article"
  image={article.data.thumbnail}
  jsonLd={[articleSchema, breadcrumb]}
>
  <Navbar variant="secondary" />
  <main class="main-wrapper">
    <BlogPostHero article={article} />
    <BlogPostContent article={article} />
    <BlogRelated current={article} />
    <Footer />
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Protected page" description="Protected page" noindex={true}>
  <div class="utility-page_component">
    <div class="utility-page_wrapper w-password-page w-form">
      <form action="/.wf_auth" method="post" id="email-form" name="email-form" data-name="Email Form" class="utility-page_form w-password-page"><img alt="" width="106" src="https://d3e54v103j8qbb.cloudfront.net/static/utility-lock.ae54711958.svg" class="utility-page_image">
        <h3>Pagina protegida</h3><input class="form_input w-password-page w-input" autofocus maxlength="256" name="pass" data-name="field" placeholder="Enter your password" type="password" id="pass"><input data-wait="Please wait..." type="enviar" class="button w-password-page w-button" value="Enviar">
        <div class="form_message-error w-password-page w-form-fail">
          <div>Senha incorreta. Tente novamente.</div>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

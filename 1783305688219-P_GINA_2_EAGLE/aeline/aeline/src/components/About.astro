---
---
<section class="section_about">
  <div class="padding-section-large"></div>
  <div class="padding-global">
    <div class="container-large">
      <div class="vertical-center">
        <div data-reveal class="tag">
          <div class="dot-square"></div>
          <div>Sobre nos</div>
        </div>
        <div class="spacer-large"></div>
        <div data-reveal class="max-width-medium is-41rem">
          <div class="title-wrap">
            <h2>Conectamos</h2>
            <h2>tecnologia</h2>
            <h2>e resultado</h2>
            <h2>para</h2>
            <h2>o seu</h2><img src="/images/icon1.svg" loading="lazy" alt="" class="title-icon">
            <h2>negócio</h2>
            <h2 class="opacity-50">com</h2><img src="/images/icon2.svg" loading="lazy" alt="" class="title-icon">
            <h2 class="opacity-50">inteligência</h2>
            <h2 class="opacity-50">artificial</h2>
          </div>
        </div>
      </div>
      <div class="spacer-section-large"></div>
      <div class="about_layout">
        <div class="card_about"><img src="/images/card-about-img.avif" loading="lazy" alt="" class="img">
          <div class="vertical-space-between">
            <div class="card_1-top"><img src="/images/ipsum-logo.svg" loading="lazy" alt="">
              <div class="container-svg"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" class="icon-1x1-medium">
                  <path d="M16 20V13H20V20H16ZM10 20V4H14V20H10ZM4 20V9H8V20H4Z" fill="currentColor"></path>
                </svg></div>
            </div>
            <div class="about_card-float">
              <div class="text-wrap">
                <div fs-numbercount-duration="1100" fs-numbercount-element="number" fs-numbercount-comeca="0" fs-numbercount-end="4" class="text-5xl">4</div>
                <div class="text-5xl"></div>
              </div>
              <div class="spacer-small"></div>
              <div class="text-weight-medium">Planos de agentes de IA para atendimento, qualificação e vendas.</div>
            </div>
          </div>
        </div>
        <div class="card_about bg-subtle">
          <div>
            <div class="text-weight-medium">Foco em resultados mensuráveis</div>
            <div class="spacer-small"></div>
            <div class="text-wrap">
              <div fs-numbercount-duration="1000" fs-numbercount-element="number" fs-numbercount-comeca="0" fs-numbercount-end="100" class="text-4xl">100</div>
              <div class="text-4xl">%</div>
            </div>
          </div>
          <div>
            <div class="avatars-wrap">
              <div class="avatar-item is-first"><img loading="lazy" src="/images/users-1.avif" alt="" class="img"></div>
              <div class="avatar-item is-second"><img loading="lazy" src="/images/users-2.avif" alt="" class="img"></div>
              <div class="avatar-item is-third"><img loading="lazy" src="/images/users-3.avif" alt="" class="img"></div>
              <div class="avatar-item is-fourth"><img loading="lazy" src="/images/users-4.avif" alt="" class="img"></div>
            </div>
            <div class="spacer-small"></div>
            <div class="text-base text-weight-medium">“A automação da Novus AI transformou completamente nosso atendimento. É eficiente, inteligente e humanizado.”</div>
          </div>
        </div>
        <div class="card_about bg-green height-100">
          <div class="vertical-space-between">
            <div>
              <div class="text-weight-medium">Departamentos atendidos</div>
              <div class="spacer-small"></div>
              <div class="text-wrap">
                <div fs-numbercount-duration="1400" fs-numbercount-element="number" fs-numbercount-comeca="0" fs-numbercount-end="8" class="text-4xl">8</div>
                <div class="text-4xl">+</div>
              </div>
            </div>
            <div class="text-base text-weight-medium">Comercial, atendimento, marketing, RH, financeiro, jurídico, TI e operações.</div>
          </div>
        </div>
        <div class="card_about bg-black">
          <div class="card_4-content">
            <div class="text-weight-medium text-color-on-primary">Segmentos atendidos</div>
            <div class="text-wrap text-color-on-primary">
              <div fs-numbercount-duration="1000" fs-numbercount-element="number" fs-numbercount-comeca="0" fs-numbercount-end="8" class="text-4xl">8</div>
              <div class="text-4xl">+</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="padding-section-large"></div>
</section>
